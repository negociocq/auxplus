# Copie para .env.local se for rodar fora do Dyad.
# No Dyad Free, essas vars vêm da integração Supabase.

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key

# Opcional — fallback da Evolution API (preferível configurar em Admin → API)
# VITE_EVOLUTION_API_URL=https://sua-evolution.com
# VITE_EVOLUTION_API_KEY=sua_chave

# Evolution API configuration options:
# - Local: VITE_EVOLUTION_API_URL=http://localhost:8080
# - Remote: VITE_EVOLUTION_API_URL=https://sua-evolution.com
# - Ngrok: VITE_EVOLUTION_API_URL=https://abc123.ngrok.io
# - Cloudflare Tunnel: VITE_EVOLUTION_API_URL=https://sua-evolution.yourdomain.com
